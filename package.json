{
  "name": "jev-interface-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-manifest-validator.mjs",
    "build": "next build",
    "schema:generate": "node scripts/generate-manifest-validator.mjs",
    "db:migrate": "node scripts/migrate.mjs",
